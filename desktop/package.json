{
  "name": "techcare-desktop",
  "version": "1.0.0",
  "description": "TechCare (pruebas) — aplicación de escritorio (envoltorio Electron del sitio web).",
  "author": "Asociación Nuevo Amanecer (ANA)",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "build": "npm run icon && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "31.7.6",
    "electron-builder": "25.1.8",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "org.ana-hn.techcare.pruebas",
    "productName": "TechCare Pruebas",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "build/icon.png"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TechCare Pruebas"
    }
  }
}
