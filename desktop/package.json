{
  "name": "techcare-desktop",
  "version": "7.9.2",
  "description": "TechCare (pruebas) — aplicación de escritorio (envoltorio Electron del sitio web).",
  "author": "Asociación Nuevo Amanecer (ANA)",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "build": "npm run icon && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "31.7.6",
    "electron-builder": "25.1.8",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "org.ana-hn.techcare.pruebas",
    "productName": "TechCare Pruebas",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "updater-preload.js", "offline.html", "updater.html", "build/icon.png", "node_modules/**/*"],
    "publish": [
      {
        "provider": "generic",
        "url": "http://192.168.10.6:453/",
        "channel": "latest"
      }
    ],
    "win": {
      "target": ["nsis", "portable", "msi"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TechCare Pruebas",
      "artifactName": "TechCare-Pruebas-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TechCare-Pruebas-Portable-${version}.${ext}"
    },
    "msi": {
      "perMachine": true,
      "artifactName": "TechCare-Pruebas-${version}.${ext}"
    }
  }
}
