# ─────────────────────────────────────────────────────────────────────────────
# TechCare · PRUEBAS — plantilla de variables de entorno
# Copia este archivo a system_proyect/.env (o pégalo en las variables de Coolify)
# y rellena los valores. NUNCA subas el .env real al repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ──
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=false
# Servir estáticos con WhiteNoise dentro del contenedor (déjalo en true para Coolify)
USE_WHITENOISE=true
# Ejecutar migraciones al arrancar. ⚠️ SOLO true si DB_* apunta a una base de PRUEBA,
# nunca contra la base de producción (alteraría el esquema real).
RUN_MIGRATIONS=0
GUNICORN_WORKERS=3

# ── MySQL (base propia de TechCare) ──
# ⚠️ Por defecto es la MISMA base del servidor. Para pruebas seguras, apunta a una copia.
DB_NAME=sponsors2
DB_USER=
DB_PASSWORD=
DB_HOST=192.168.10.6
DB_PORT=3306

# ── SQL Server · Test2 (copia académica / padres) ──
MSSQL_TEST2_DB_NAME=Test2
MSSQL_TEST2_DB_USER=
MSSQL_TEST2_DB_PASSWORD=
MSSQL_TEST2_DB_HOST=192.168.10.2
MSSQL_TEST2_DB_PORT=1433
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── SQL Server · AdmonANASQL (base académica REAL, solo lectura) ──
MSSQL_REAL_DB_NAME=AdmonANASQL

# ── SQL Server · zkbiotime (reloj biométrico) ──
MSSQL_ZKBIO_DB_NAME=zkbiotime
MSSQL_ZKBIO_DB_USER=
MSSQL_ZKBIO_DB_PASSWORD=
MSSQL_ZKBIO_DB_HOST=192.168.10.2
MSSQL_ZKBIO_DB_PORT=1433

# ── Notas de Parcial: qué base usar / áreas ya migradas a la real ──
NOTAS_PARCIAL_DB=padres_sqlserver
NOTAS_PARCIAL_AREAS_REAL=

# ── Correo principal (Gmail) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Correos por área (enfermería / coord BL / coord COL) ──
EMAIL_ENF_HOST=mail.ana-hn.org
EMAIL_ENF_PORT=465
EMAIL_ENF_USE_SSL=true
EMAIL_ENF_USE_TLS=false
EMAIL_ENF_USER=
EMAIL_ENF_PASSWORD=

EMAIL_COORD_BL_HOST=mail.ana-hn.org
EMAIL_COORD_BL_PORT=465
EMAIL_COORD_BL_USE_SSL=true
EMAIL_COORD_BL_USE_TLS=false
EMAIL_COORD_BL_USER=
EMAIL_COORD_BL_PASSWORD=

EMAIL_COORD_COL_HOST=mail.ana-hn.org
EMAIL_COORD_COL_PORT=465
EMAIL_COORD_COL_USE_SSL=true
EMAIL_COORD_COL_USE_TLS=false
EMAIL_COORD_COL_USER=
EMAIL_COORD_COL_PASSWORD=

# ── OpenAI (opcional) ──
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=
OPENAI_MAX_TOKENS=
OPENAI_TIMEOUT=
